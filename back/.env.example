# Backend API (NestJS)
PORT=3001
NODE_ENV=development

DB_SERVER=localhost
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=your_password
DB_NAME=your_database

DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

JWT_SECRET=change_me_at_least_8_chars
JWT_EXPIRES_IN=10h

# CORS: origin del front Vite por defecto
CORS_ORIGIN=http://localhost:5173

# URL pública del API (para armar links de avatares en /api/v1/users)
API_PUBLIC_BASE_URL=http://localhost:3001

# Carpeta de fotos de pacientes (misma que usa CeereLite en STATIC_IMAGES_PATH)
STATIC_IMAGES_PATH=C:/CeereSio/Foto Entidad
