# Backend API (NestJS)
# Copiar a `.env` y completar. No commitear `.env`.

PORT=3001
NODE_ENV=development

# SQL Server. Instancia nombrada: SERVIDOR\INSTANCIA (ej. TUFF16\MSSQLSERVER2019)
DB_SERVER=localhost
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=your_password
DB_NAME=your_database

DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# Mínimo 8 caracteres. Obligatorio distinto en cada ambiente.
JWT_SECRET=change_me_at_least_8_chars
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=change_me_refresh_at_least_8
JWT_REFRESH_EXPIRES_IN=10h

# Origin del front Vite
CORS_ORIGIN=http://localhost:5173

# URL pública del API (links de avatares en GET /api/v1/users)
API_PUBLIC_BASE_URL=http://localhost:3001

# Fotos de pacientes (misma carpeta que CeereLite)
STATIC_IMAGES_PATH=C:/CeereSio/Foto Entidad

# Formatos HTML de historia clínica (CeereSio)
FORMATOS_HC_PATH=C:/CeereSio/Formatos HC

# Firmas de profesionales (img name="Entidad3")
FIRMA_ENTIDAD_PATH=C:/CeereSio/Firma Entidad

# Documentos anexos del paciente (tabla Documento Anexo)
DOCUMENTOS_PATH=C:/CeereSio/Documentos

# --- IHCE / RDACE (sandbox + prod) ---
# Aún no las consume el Nest (RDA persistencia FHIR/IHCE pendiente).
# Se documentan para alinear con CeereLite y no perderlas al copiar el example.

IHCE_SANDBOX_BASE_URL=https://sandbox.ihcecol.gov.co/ihce
IHCE_SANDBOX_TENANT_ID=
IHCE_SANDBOX_CLIENT_ID=
IHCE_SANDBOX_CLIENT_SECRET=
IHCE_SANDBOX_SCOPE=
IHCE_SANDBOX_SUBSCRIPTION_KEY=
IHCE_SANDBOX_CUSTODIAN_REPS=
IHCE_SANDBOX_CUSTODIAN_NIT=
IHCE_SANDBOX_CUSTODIAN_NAME=

IHCE_PROD_BASE_URL=https://www.ihcecol.gov.co/ihce
IHCE_PROD_TENANT_ID=
IHCE_PROD_CLIENT_ID=
IHCE_PROD_CLIENT_SECRET=
IHCE_PROD_SCOPE=
IHCE_PROD_SUBSCRIPTION_KEY=
IHCE_PROD_CUSTODIAN_NIT=
IHCE_PROD_CUSTODIAN_REPS=
IHCE_PROD_CUSTODIAN_NAME=

IHCE_RDACE_DEFAULT_NIT_IPS=
IHCE_RDACE_DEFAULT_NOMBRE_IPS=
